# Sunucu portu
PORT=8787
# Siparişlerin ve fotoğrafların tutulduğu klasör (kalıcı bir disk olmalı)
DATA_DIR=./data
# Yönetim paneli anahtarı: uzun ve rastgele bir değer verin (örn. `openssl rand -hex 24`)
ADMIN_TOKEN=
# Havale/EFT bilgileri (sipariş sonrası müşteriye gösterilir)
BANK_NAME=
BANK_HOLDER=
BANK_IBAN=
# Müşterinin göreceği iletişim adresi
CONTACT_EMAIL=
# nginx / Cloudflare arkasında çalışıyorsa 1
TRUST_PROXY=0
# İsteğe bağlı: fiyat ayarları (JSON). Ya da DATA_DIR/pricing.json dosyası.
# PRICING_JSON={"designFee":249,"packaging":60,"shipping":90,"markup":2.5}
